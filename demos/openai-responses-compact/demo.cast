[0.315278, "o", "\u001b[6d\u001b[2m2026-09-14T10:44:30.547196Z\u001b(B\u001b[m \u001b[34mDEBUG\u001b[39m \u001b[1mhttp_request\u001b(B\u001b[m\u001b[2m:\u001b(B\u001b[m\u001b[1mfilter\u001b(B\u001b[m\u001b[2m:\u001b(B\u001b[m \u001b[2mpraxis_ai_apis::openai::responses::rehydrate:\u001b(B\u001b[m previous response validated, state populated \u001b[3mprevious_response_id\u001b(B\u001b[m\u001b[2m=\u001b(B\u001b[mresp_238806\u001b[70;1H"]
[34.449471, "o", "\u001b[?25l\u001b[30m\u001b[42m\r\n[praxis-co0:bash*\u001b[260X\u001b[260C\"acristur-thinkpadp1ge\" 12:45 14-Sep-26\u001b(B\u001b[m\u001b[?12l\u001b[?25h\u001b[70;1H"]
[19.185318, "o", "\u001b[32;70r\u001b[1;1H\u001b[4S\u001b[66d\u001b[1m{\r\n\u001b(B\u001b[m  \u001b[34m\u001b[1m\"object\"\u001b[39m:\u001b(B\u001b[m \u001b[32m\"response.compaction\"\u001b[39m\u001b[1m,\u001b(B\u001b[m\u001b[K\r\n  \u001b[34m\u001b[1m\"type\"\u001b[39m:\u001b(B\u001b[m \u001b[32m\"compaction\"\u001b[39m\u001b[1m,\u001b(B\u001b[m\u001b[K\r\n  \u001b[34m\u001b[1m\"summary\"\u001b[39m:\u001b(B\u001b[m \u001b[32m\"**Extensive TCP vs UDP Summary**\\n\\n**Introduction**\\n\\nTCP (Transmission Control Protocol) and UDP (User Datagram Protocol) are two fundamental communication protocols used in computer networking. While they share some similarities, they also have distinct differences in terms of their behavior, advant \u001b[39m\u001b[K\u001b[32m…\u001b[39m\r\u001b[2S\u001b[68;5H\u001b[32m\"\u001b[39m\u001b[1m,\r\n\u001b(B\u001b[m  \u001b[34m\u001b[1m\"usage\"\u001b[39m:\u001b(B\u001b[m \u001b[1m{\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[1;71r\u001b[70;1H"]
[0.000139, "o", "\u001b[32;70r\u001b[1;1H\u001b[12S\u001b[58d    \u001b[34m\u001b[1m\"input_tokens\"\u001b[39m:\u001b(B\u001b[m 1090\u001b[1m,\r\n\u001b(B\u001b[m    \u001b[34m\u001b[1m\"input_tokens_details\"\u001b[39m:\u001b(B\u001b[m \u001b[1m{\u001b(B\u001b[m\u001b[K\r\n      \u001b[34m\u001b[1m\"cached_tokens\"\u001b[39m:\u001b(B\u001b[m 1084\u001b[1m,\u001b(B\u001b[m\u001b[K\r\n      \u001b[34m\u001b[1m\"cache_write_tokens\"\u001b[39m:\u001b(B\u001b[m 0\u001b[K\r\n    \u001b[1m},\u001b(B\u001b[m\u001b[K\r\n    \u001b[34m\u001b[1m\"output_tokens\"\u001b[39m:\u001b(B\u001b[m 1041\u001b[1m,\u001b(B\u001b[m\u001b[K\r\n    \u001b[34m\u001b[1m\"output_tokens_details\"\u001b[39m:\u001b(B\u001b[m \u001b[1m{\u001b(B\u001b[m\u001b[K\r\n      \u001b[34m\u001b[1m\"reasoning_tokens\"\u001b[39m:\u001b(B\u001b[m 0\u001b[K\r\n    \u001b[1m},\u001b(B\u001b[m\u001b[K\r\n    \u001b[34m\u001b[1m\"total_tokens\"\u001b[39m:\u001b(B\u001b[m 2131\u001b[K\r\n  \u001b[1m}\u001b(B\u001b[m\u001b[K\r\n\u001b[1m}\u001b(B\u001b[m\u001b[K\r\n\u001b[K\u001b[1;71r\u001b[70;1H\u001b[?25l\u001b[?12l\u001b[?25h"]
[3.003219, "o", "\u001b[32;70r\u001b[70;1H\n\u001b[32m\u001b[1mDone.\u001b(B\u001b[m History compaction \u001b[K—\r\u001b[3S\u001b[67;27H a large stored conversation\r\ncollapsed into a short summary, both reactively on a follow-up and\u001b[K\r\nexplicitly via /v1/responses/compact, keeping the forwarded context\u001b[K\r\n\u001b[K\u001b[1;71r\u001b[70;1H\u001b[32;70r\u001b[70;1H\n\u001b[Aunder the token threshold.\r\n\u001b[K\u001b[1;71r\u001b[70;1H\u001b[?25l\u001b[?12l\u001b[?25h"]
[5.019561, "o", "\u001b[1;71r\u001b(B\u001b[m\u001b[?1l\u001b>\u001b[H\u001b[2J\u001b[?12l\u001b[?25h\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006l\u001b[?1005l\u001b[?2004l\u001b[?7727l\u001b[?1004l\u001b[?1049l\u001b[23;0;0t\u001b[?2031l"]
[0.000253, "o", "[exited]\r\n"]
