# == Policy document ==
plugins:
- name: keycloak-jwt
  kind: identity/jwt
  capabilities:
  - perform_http
  hooks:
  - identity.resolve
  on_error: fail
  config:
    role: user
    header: Authorization
    trusted_issuers:
    - issuer: http://localhost:8081/realms/policy-demo
      skip_audience_validation: true
      algorithms:
      - RS256
      decoding_key:
        kind: jwks_url
        url: http://localhost:8081/realms/policy-demo/protocol/openid-connect/certs
    claim_mapper: standard
routes:
- http:
    path_prefix: /api
    method:
    - GET
  authorization:
    pre_invocation:
    - cel:
        expr: ((has(perm.tool_execute) && perm.tool_execute))
- http:
    path_prefix: /api
    method:
    - POST
    - DELETE
  authorization:
    pre_invocation:
    - cel:
        expr: ((has(role.hr) && role.hr))
- http:
    path_prefix: /
global:
  authentication:
  - keycloak-jwt
  authorization:
    pre_invocation:
    - require(authenticated)
  pdp:
  - kind: cel

# == Praxis filter block ==
filter: policy
config_path: /etc/praxis/jwt-cel-http-policy-doc.yaml

