# TEMPLATE — this file is the source; policy-verify-opa.yaml is GENERATED from it.
#
# Edit THIS file, never the generated one. restart.sh renders it on every Verify
# run (see render-verify-config.sh), so edits to policy-verify-opa.yaml are
# silently overwritten and the generated file is gitignored.
#
#   ./render-verify-config.sh            # render once, by hand
#   GATEWAY_CONFIG=praxis-verify-opa.yaml ./restart.sh   # renders automatically
#
# Two placeholders are substituted, both from the environment (restart.sh sources
# ./.env.verify first). Neither is a secret — the client SECRET is not templated;
# it stays a runtime `client_secret_source: {kind: env_var}` lookup by the gateway
# so it never lands in a rendered file on disk.
#
#   ${VERIFY_TENANT_URL}          e.g. https://praxis-1.verify.ibm.com
#                                 defaults to the tenant in post_deploy_variables.json
#   ${VERIFY_GATEWAY_CLIENT_ID}   the EXCHANGE client's id (praxis-sts-1)
#                                 defaults to GATEWAY_CLIENT_ID in that same file
#
# Both defaults mean a normal run needs no extra setup: the ids that
# verify/import-verify-clients.sh writes into post_deploy_variables.json are
# picked up automatically. Export either variable to override.
#
# ---------------------------------------------------------------------------
# Policy engine config for the HR demo — IBM VERIFY variant of policy-opa.yaml.
#
# The point of this file is what it does NOT change. Diff it against
# policy-opa.yaml and every difference is in the identity and delegation config
# blocks: the routes, the APL policy text, the OPA/Rego PDP, the PII scanner,
# the redaction rules, the taint labels and the audit logger are byte-identical.
# That is the demo's argument — the policy layer is IdP-agnostic, and the diff
# is the evidence.
#
# Run with (BOTH switches — see praxis-verify-opa.yaml for why):
#   USE_VERIFY=true GATEWAY_CONFIG=praxis-verify-opa.yaml ./restart.sh
#
# Hot path:
#   1. jwt-user      validates X-User-Token against Verify (the tenant below)
#                    → security.subject + raw_credentials.inbound_tokens[User]
#   2. jwt-client    validates Authorization against Verify (same tenant)
#                    → security.client
#   3. APL gate      require(role.hr) on the get_compensation tool
#   4. APL delegate  workday-oauth exchanges the user's IdP token for an
#                    audience=workday-api token via Verify (RFC 8693)
#   5. APL args      ssn arg gets redacted unless caller has perm.view_ssn
#
# Verify is public HTTPS at ${VERIFY_TENANT_URL}/oauth2, so no
# insecure_http / loopback opt-in is needed on the IdP side. Access tokens are
# RS256 `at+jwt` (kid: server); we point at the tenant JWKS so the resolver
# fetches the active public key at init time.
#
# Two known deltas from the Keycloak path, both properties of the tenant rather
# than of the gateway or the policy. Neither changes a scenario outcome, both
# change what can honestly be narrated:
#
#   V1 — `aud` is client-bound, not request-scoped. Every minted token carries
#        the exchanging client's full registered resource list regardless of the
#        requested `audience`, and an unregistered audience is accepted
#        silently. Say "exchanged token," not "audience-scoped token."
#   V2 — layer 4 is an echo, not an entitlement check. See github-oauth below.
#
# Verify emits roles/teams/permissions as SCALARS at N=1, and the standard claim
# mapper reads them via Value::as_array, which returns None for a JSON string —
# yielding an empty subject.roles with no error, which then presents as a policy
# deny rather than a config fault. This used to be worked around on the tenant, by
# padding each claim with a trailing empty string so the value was always an
# array, at the cost of "" becoming a real set member in audit records and
# X-Policy-* debug output.
#
# `claim_mapper: ibmverify` below is the fix: the preset wraps a scalar into a
# one-element vec, so the tenant's claims are unpadded now. The two settings go
# together — an unpadded tenant read WITHOUT the preset silently empties
# subject.roles for every single-valued persona.

engine_settings:
  dispatch: policy

plugins:
  # User identity. Carries the human's roles + permissions claims.
  - name: jwt-user
    capabilities:
      # PPE performs no outbound HTTP of its own, so a plugin that reaches an
      # IdP declares this or the engine refuses to start.
      - perform_http
    kind: identity/jwt
    hooks: [identity.resolve]
    mode: sequential
    on_error: fail
    config:
      role: user
      header: X-User-Token
      # Verify only. The Keycloak issuer is deliberately absent: this config's
      # job is to prove the policy layer works against Verify, and leaving both
      # trusted would let a Keycloak-minted token satisfy the demo without
      # anyone noticing which IdP actually validated it.
      #
      # `audiences` is the friendly name rather than the client UUID because
      # Verify stamps its full registered resource list on every token (delta
      # V1) and praxis-gateway is in it — verified on the live tenant.
      trusted_issuers:
        - issuer: "${VERIFY_TENANT_URL}/oauth2"
          audiences: ["praxis-gateway"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "${VERIFY_TENANT_URL}/oauth2/jwks"
          leeway_seconds: 60
        - issuer: "http://localhost:8081/realms/policy-demo"
          audiences: ["praxis-gateway"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "http://localhost:8081/realms/policy-demo/protocol/openid-connect/certs"
            insecure_http: true   # localhost dev — never production
          leeway_seconds: 60
      claim_mapper: ibmverify

  # Client identity. Carries the agent's client_id / azp.
  - name: jwt-client
    capabilities:
      # PPE performs no outbound HTTP of its own, so a plugin that reaches an
      # IdP declares this or the engine refuses to start.
      - perform_http
    kind: identity/jwt
    hooks: [identity.resolve]
    mode: sequential
    on_error: fail
    config:
      role: client
      header: Authorization
      # Verify only — same reasoning as jwt-user above.
      trusted_issuers:
        - issuer: "${VERIFY_TENANT_URL}/oauth2"
          audiences: ["praxis-gateway", "account"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "${VERIFY_TENANT_URL}/oauth2/jwks"
          leeway_seconds: 60
        - issuer: "http://localhost:8081/realms/policy-demo"
          audiences: ["praxis-gateway"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "http://localhost:8081/realms/policy-demo/protocol/openid-connect/certs"
            insecure_http: true   # localhost dev — never production
          leeway_seconds: 60
      claim_mapper: ibmverify

  # Scenario 14: the AGENT's own identity. A governed IBM Verify Agent Identity
  # mints with client_credentials and acts as itself — no human, no user token.
  #
  # role: subject, not a bespoke "agent" role. There is no agent identity slot
  # in the engine (the slots are subject / client / caller_workload /
  # this_workload), and on this route the agent IS the subject: there is nobody
  # else. `read_agent`/AgentExtension is NOT an identity — it carries session
  # and conversation state.
  #
  # The token is a true JWT because the agent's client is an application-level
  # OIDC client with accessTokenType: jwt. A Dynamic Client Registration client
  # mints an opaque token this resolver could not validate — see delta A1 in
  # docs/brainstorms/2026-10-20-verify-agent-identity-requirements.md.
  #
  # It carries NO roles/teams/permissions: attribute mappers read user
  # attributes and a client_credentials grant has no user (finding E3). Its
  # authority is the `scope` it requests, which the agent route gates on.
  - name: jwt-agent
    capabilities:
      - perform_http
    kind: identity/jwt
    hooks: [identity.resolve]
    mode: sequential
    on_error: fail
    config:
      # `user` is the role name the engine accepts (user | client | workload);
      # it writes security.subject, which is the slot the agent-status plugin
      # reads. There is no "agent" or "subject" role — the engine rejects
      # anything else as role: Custom(...), which is not supported.
      #
      # The agent IS the subject on this route: there is no human. Naming it
      # `user` is a vocabulary artifact of the engine, not a claim that a person
      # is involved.
      role: user
      header: X-Agent-Token
      trusted_issuers:
        - issuer: "${VERIFY_TENANT_URL}/oauth2"
          # The agent's client lists praxis-gateway in its audiences so the
          # gateway can validate the token it is handed.
          audiences: ["praxis-gateway"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "${VERIFY_TENANT_URL}/oauth2/jwks"
          leeway_seconds: 60
      # `standard`, not `ibmverify`: the preset exists to wrap scalar
      # roles/teams/permissions into sets, and this token carries none of them.
      # Nothing to normalise, so nothing to gain.
      claim_mapper: standard

  # Scenario 14: refuses the call when the agent is not ACTIVE in the IBM Verify
  # Agent Registry.
  #
  # This is the demo's kill switch, and the half SPIFFE does not have: an admin
  # suspends a named agent in a console and the next call fails.
  #
  # It has to live here rather than at the IdP because Verify does NOT enforce
  # status at the token endpoint — a SUSPENDED agent still mints tokens, and
  # tokens minted before the suspend stay valid (finding E1, measured). That is
  # also IBM's own architecture: the vault cookbook's Use Case C has the token
  # exchange succeed while the RESOURCE denies. Praxis is the resource here.
  #
  # cache_ttl_seconds IS the revocation window: a suspended agent keeps working
  # until its entry expires. Stated rather than hidden, because it is the fair
  # comparison against an SVID's TTL.
  - name: agent-status
    kind: validator/agent-status
    hooks: [cmf.tool_pre_invoke]
    mode: sequential
    on_error: fail
    capabilities:
      - perform_http      # the registry GET and the admin token mint
      - read_subject      # unlocks security.subject
      - read_claims       # ... and its claims, where an agent id may appear
    config:
      registry_url: "${VERIFY_TENANT_URL}/v1.0/Agents"
      # Which agent record to check. A Verify client_credentials token carries
      # sub/client_id (the OAuth client) but no claim naming its Agent Registry
      # record, and the association is write-only registry-side, so it cannot
      # be resolved by lookup either. verify/import-verify-clients.sh writes
      # this id into post_deploy_variables.json.
      agent_id: "${VERIFY_AGENT_ID}"
      # A dedicated API client holding exactly ONE entitlement, readAgents.
      # NOT the admin client: that one carries ~40 entitlements including
      # writeAgents and agentOwner, so a gateway compromise could rewrite the
      # records that govern it — including silently re-enabling a suspended
      # agent. With readAgents alone the gateway can read an agent record and
      # nothing else (PUT /v1.0/Agents, POST /v2.0/Users and
      # GET /v1.0/applications are all 403; verified on praxis-2).
      #
      # verify/import-verify-clients.sh creates it and appends its credentials
      # to .env.verify. The admin pair stays provisioning-only.
      admin_client_id: "${VERIFY_AGENT_READER_CLIENT_ID}"
      # A NAME, not the secret: this file is generated onto disk, and a live
      # tenant credential must not land in it. restart.sh sources .env.verify.
      admin_client_secret_env: VERIFY_AGENT_READER_CLIENT_SECRET
      cache_ttl_seconds: 5
      # An unreachable registry denies. A kill switch that fails open is not a
      # kill switch; the cost is that the agent route needs the tenant up.
      on_unavailable: deny

  # RFC 8693 token-exchange delegator. Trades the user's hr-copilot
  # token for a workday-api-audience-scoped access token.
  #
  # Pattern 1 (workday flow): the user already carries view_ssn etc.
  # as a Verify user attribute → claim. The exchange just changes
  # the audience; the perms come along for the ride.
  - name: workday-oauth
    kind: delegator/oauth
    hooks: [token.delegate]
    mode: sequential
    on_error: fail
    capabilities:
      # PPE performs no outbound HTTP of its own, so a plugin that reaches an
      # IdP declares this or the engine refuses to start.
      - perform_http
      - read_inbound_credentials
      - write_delegated_tokens
    config:
      token_endpoint: "${VERIFY_TENANT_URL}/oauth2/token"
      # No insecure_http: Verify is public HTTPS.
      #
      # This is the EXCHANGE client, deliberately different from the client
      # mint-verify-token.sh uses to mint (HR_COPILOT_CLIENT_ID in
      # post_deploy_variables.json). Verify refuses to let a
      # client exchange tokens it issued itself:
      #   CSIAQ5207E Clients are not allowed to perform a token exchange on
      #              their own tokens.
      # Same split as the Keycloak realm's hr-copilot mints / praxis-gateway
      # exchanges. Point both at one client and every scenario fails at
      # delegation, not at identity.
      client_id: "${VERIFY_GATEWAY_CLIENT_ID}"
      # Live tenant secret, so it is read from the environment rather than
      # tracked in git. restart.sh sources ./.env.verify when present; see
      # .env.verify.example. (`kind: literal` with an inline `secret:` is what
      # the Keycloak configs use — safe only because those credentials are
      # throwaway localhost ones.)
      client_secret_source:
        kind: env_var
        name: VERIFY_GATEWAY_CLIENT_SECRET
      timeout_seconds: 5
      default_outbound_header: "Authorization"

  # ----------------------------------------------------------------
  # Field-level validator: PII scanner.
  # ----------------------------------------------------------------
  # Walks tool/prompt arguments looking for SSN / credit-card / email
  # patterns. If found in `deny` mode, refuses the request. Wired on
  # `cmf.tool_pre_invoke` so it fires before every tool call.
  - name: pii-scan
    kind: validator/pii-scan
    hooks: [cmf.tool_pre_invoke]
    mode: sequential
    on_error: fail
    config:
      detect:
        - { kind: ssn }
        - { kind: credit_card }
      mode: deny

  # ----------------------------------------------------------------
  # Observation: structured audit logger.
  # ----------------------------------------------------------------
  # Emits one JSON line per dispatched request capturing subject,
  # client, entity, tool args, and any delegation outcomes. Never
  # blocks — observation only.
  #
  # One hook, because this demo declares only `tool:` routes. Under
  # `dispatch: policy` a plugin runs where a `run(name)` step names it, so
  # declaring the prompt and resource hooks too would leave two of the three
  # uncovered and the load would say so. Add them back alongside the routes
  # that need them.
  - name: audit-log
    kind: audit/logger
    hooks:
      - cmf.tool_pre_invoke
    mode: sequential
    # Ordering is the order the document writes the steps: a `run(name)`
    # step invokes the one plugin it names, so this records the final
    # decision and the minted tokens by sitting last.
    on_error: ignore  # observation failures don't halt traffic
    capabilities:
      - read_subject
      - read_client
      - read_meta
      - read_delegated_tokens
    config:
      destination: stderr
      source: policy-demo-gateway

  # Second delegator — same plugin kind, different audience.
  #
  # Pattern 3 (github flow). On Keycloak the github-api client has a
  # per-audience claim mapper (`gh-permissions-as-scope`) that derives the
  # minted token's `permissions` from the user's own gh_permissions attribute,
  # so the IdP is the source of system-specific perm truth and can refuse
  # authority the user lacks.
  #
  # Verify does NOT do that — it echoes whatever `scope` was requested (delta
  # V2). Scenario 4's layer-4 assertion still passes, but it verifies wire-shape
  # parity rather than an authorization decision. Narrate it as "the gateway
  # asserts the minted token carries the authority the route requires" and do
  # not claim the IdP refused anything on this path.
  - name: github-oauth
    kind: delegator/oauth
    hooks: [token.delegate]
    mode: sequential
    on_error: fail
    capabilities:
      # PPE performs no outbound HTTP of its own, so a plugin that reaches an
      # IdP declares this or the engine refuses to start.
      - perform_http
      - read_inbound_credentials
      - write_delegated_tokens
    config:
      token_endpoint: "${VERIFY_TENANT_URL}/oauth2/token"
      # No insecure_http: Verify is public HTTPS.
      # The exchange client again — see the note on workday-oauth above.
      client_id: "${VERIFY_GATEWAY_CLIENT_ID}"
      client_secret_source:
        kind: env_var
        name: VERIFY_GATEWAY_CLIENT_SECRET
      timeout_seconds: 5
      default_outbound_header: "Authorization"

  # ----------------------------------------------------------------
  # Human-in-the-loop: CIBA manager approval.
  # ----------------------------------------------------------------
  # Drives an out-of-band approval through OIDC CIBA: the gateway POSTs
  # a backchannel auth request to Keycloak (login_hint = the approver),
  # Keycloak pushes a decoupled prompt to the approver's device (the
  # demo's web approval UI), and the gateway polls until it resolves.
  # While pending, the gateway emits JSON-RPC -32120 so the agent can
  # tell the user "awaiting sign-off" and retry — it never blocks.
  # Registered under the name `manager-approver`; the route names it.
  - name: manager-approver
    capabilities:
      # PPE performs no outbound HTTP of its own, so a plugin that reaches an
      # IdP declares this or the engine refuses to start.
      - perform_http
    kind: elicitation/ciba
    hooks: [elicit]
    mode: sequential
    on_error: fail
    config:
      # STILL KEYCLOAK, deliberately — and both endpoints stay paired, because
      # retargeting only the token endpoint would poll Verify for an
      # auth_req_id that Keycloak issued.
      #
      # Verify advertises the CIBA grant in its discovery document
      # (/oauth2/ciba, poll delivery), but two things block it on this tenant
      # today. Both were tested on 2026-09-15, not assumed:
      #
      #   1. Neither tenant client may use the grant. Both the minting client
      #      (4bde48ec-…) and the exchange client (c619871a-…) return:
      #        CSIAQ5303E The OAuth 2.0 Client is not allowed to use
      #                   authorization grant "urn:openid:params:grant-type:ciba"
      #      Fix is tenant-side: enable the CIBA grant on the client.
      #
      #   2. No `manager` claim exists on a Verify token, and
      #      require_approval(from: claim.manager) on the adjust_compensation
      #      route needs one. Bob's token carries preferred_username/roles/
      #      teams/permissions/gh_permissions and no manager attribute. Fix is
      #      also tenant-side: add the attribute and map it into the token.
      #
      # Consequence: scenarios 10-11 must run on the Keycloak path. Scenario 10
      # (under-threshold) never reaches this plugin and so is fine either way;
      # scenario 11 is the one that needs Keycloak. walkthrough.sh runs
      # scenarios 1-7 and touches neither.
      backchannel_endpoint: "http://localhost:8081/realms/policy-demo/protocol/openid-connect/ext/ciba/auth"
      token_endpoint: "http://localhost:8081/realms/policy-demo/protocol/openid-connect/token"
      insecure_http: true   # localhost dev — never production
      client_id: "praxis-gateway"
      client_secret_source:
        kind: literal
        secret: "praxis-gateway-secret"
      scope: openid
      approver_claim: preferred_username
      default_requested_expiry_seconds: 120

global:
  authentication:
    - jwt-user
    - jwt-client

  # ----------------------------------------------------------------
  # Assertions — what the engine puts on the wire.
  # ----------------------------------------------------------------
  # Everything above this block decides. This is the only thing that tells the
  # upstream what was decided, as request headers it can read.
  #
  # The trust model first, because it is the whole story: what crosses here is
  # UNSIGNED. hr-mcp believes `x-auth-user-id` because it believes nothing
  # between this gateway and itself can set that header. If that is not true of
  # your network, this feature is not what makes it true.
  #
  # Sources are engine-derived only. A raw inbound token and the client's own
  # request headers are refused as sources, in code, with no config surface to
  # widen: rendering a client-supplied header into one the upstream trusts is
  # the laundering this exists to prevent. Scenario 12 demonstrates that.
  assertions:
    request:
      headers:
        # The stable subject identifier the JWT resolved to (`sub`).
        # `on_missing: deny` because every route here authenticates, so an
        # absent subject is a bug rather than an anonymous request to pass on.
        - name: x-auth-user-id
          from: subject.id
          on_missing: deny

        # The human-readable name, for the demo log. A claim, not a slot.
        - name: x-auth-username
          from: claim.preferred_username

        # A collection MUST declare an encoding: a set reaching an upstream in
        # a shape nobody chose is a shape nobody can rely on. Rendered sorted,
        # so one identity produces identical header bytes every request.
        - name: x-auth-roles
          from: subject.roles
          encode: csv

        # `members:` renders one JSON object with operator-chosen keys, for
        # everything that would otherwise be a header each.
        - name: x-auth-context
          members:
            manager: claim.manager
            teams: subject.teams

      # `strip:` removes names no entry above targets. The user's raw JWT is
      # one: `delegate(...)` already replaces `authorization` with the minted
      # workday-api token, and this withholds the second copy, so the upstream
      # ends up holding no credential the user issued.
      #
      # `authorization` is deliberately absent from the request protocol floor
      # precisely so this is expressible. A floor header (`host`,
      # `content-type`, `content-length`, `transfer-encoding`) fails the load
      # rather than breaking traffic.
      strip:
        - x-user-token

  # ----------------------------------------------------------------
  # OPA PDP: Rego modules evaluated in-process by regorus. No sidecar
  # and no network hop, so the decision stays on the request path.
  #
  # The module is declared here, once, and compiled at config load. A
  # Rego syntax error therefore fails the load rather than surfacing as
  # a runtime deny on the first request. Routes then query it with an
  # `opa:` step naming a rule path.
  #
  # The flat attribute bag becomes the Rego `input` document, so
  # `role.engineer` reads as `input.role.engineer` and `args.visibility`
  # as `input.args.visibility`. The vocabulary is the same one the CEL
  # and Cedar variants see.
  #
  # Choosing between the three: reach for CEL when the decision is a
  # self-contained boolean you want to read inline in the route. Reach
  # for Cedar when policy lives outside the route or needs its entity
  # and relationship model. Reach for OPA when you already have Rego,
  # or want rules that compose and can be unit-tested with the OPA
  # tooling your org already runs. All three express the SAME decision
  # here on purpose.
  #
  # `pdp:` is a `global:` key, and the only scope that accepts one: a PDP, the
  # session store and the static attribute tree are all process-global.
  # ----------------------------------------------------------------
  pdp:
    - kind: opa
      on_error: deny   # fail-closed; the default, spelled out
      modules:
        - |
          package authz

          # Absent an allow rule that fires, the answer is deny. Rego's
          # `default` is what makes this fail-closed rather than undefined.
          default allow := false

          # Engineers may read internal repos. A missing key makes the
          # body undefined rather than an error, so a request with no
          # engineer role simply does not match.
          allow if {
            input.role.engineer == true
            input.args.visibility == "internal"
          }

          # Security may read any repo, whatever its visibility.
          allow if {
            input.role.security == true
          }

  # ----------------------------------------------------------------
  # Session store — where the engine persists taint labels.
  # ----------------------------------------------------------------
  # `taint(secret, session)` on get_compensation writes a `secret`
  # label keyed by H(subject : X-Session-Id); send_email reads it back
  # via `security.labels contains "secret"`. With this Valkey backend
  # the label survives a gateway restart and can be shared across
  # gateway instances (the default is an in-process store that resets
  # on restart). Valkey runs as the `valkey` compose service; the
  # gateway reaches it on localhost:6379. See scenarios 08 / 09.
  #
  # A `global:` key, like `pdp:` above and for the same reason.
  #
  # Optional keys (read by the valkey factory):
  #   key_prefix: "taint:v1"   # default key namespace
  #   tls: true                # required for non-localhost endpoints
  #   username: / password:    # Valkey 6+ ACL auth (pair them)
  #   ttl_seconds: 86400       # sliding label expiry (default: none)
  #   connect_timeout_ms / command_timeout_ms  # defaults 250 / 500
  session_store:
    kind: valkey
    endpoint: localhost:6379

routes:

  - tool: get_compensation
    authorization:
      pre_invocation:
        - "require(role.hr)"
        - "delegate(workday-oauth, target: workday-api, audience: workday-api, permissions: [read_compensation])"
        - "taint(secret, session)"
        - "run(audit-log)"
    args:
      ssn: "str | redact(!perm.view_ssn)"
    result:
      ssn: "str | redact(!perm.view_ssn)"

  - tool: search_repos
    authorization:
      pre_invocation:
        - "require(team.engineering | team.security)"
        - opa:
            query: data.authz.allow
            on_deny:
              - "deny('engineering may read internal repos only; security may read any', 'opa.policy_denied')"
        - "delegate(github-oauth, target: github-api, audience: github-api, permissions: [repo:read:internal])"
        - "!(delegation.granted.permissions contains 'repo:read:internal'): deny"
        - "run(audit-log)"
  # Scenario 14: the agent calls search_repos on its OWN authority.
  #
  # replace_inherited drops the global jwt-user / jwt-client resolvers, so this
  # route authenticates by the agent's token alone — no X-User-Token, no
  # Authorization. Scenario 13's get_headcount route does the same thing for a
  # SPIFFE SVID; this is the Verify Agent Identity counterpart.
  #
  # run(agent-status) is FIRST so a suspended agent is refused before anything
  # else runs. It is an authorization effect rather than an authentication step
  # because a deny raised during authentication becomes HTTP 401 with a plain
  # text body, while the scenario harness asserts the violation in both the
  # X-Policy-Violation header and the JSON-RPC error body — only an
  # authorization-phase deny produces that envelope. Measured both ways.
  #
  # There is deliberately NO team gate here. The agent holds no teams claim
  # (a client_credentials token cannot carry one — finding E3) and should not
  # borrow a human's. Its authority is the route itself plus its ACTIVE status:
  # this tool exists for the agent, and agent-status decides whether the agent
  # may act at all.
  #
  # Gating on the token's `scope` was the original intent and is not currently
  # expressible: APL's attribute namespaces are role. / perm. / team. / claim. /
  # args. / client. / caller_workload. / delegation. (ppe-apl-cmf
  # constants.rs:85-139) — there is no scope. namespace, and `scope` does not
  # reach claim.* either. The agent still REQUESTS
  # scope=repo:read:internal, which bounds what the exchanged credential can
  # carry; the gateway just cannot assert on it yet.
  - tool: search_repos_agent
    authentication:
      replace_inherited: true
      steps:
        - jwt-agent
    # The global assertions describe a person (x-auth-user-id from subject.id),
    # which would here name the agent's client id. Replaced, and the strip list
    # restated: without the inherited entries nothing removes a caller's own
    # x-auth-* or a stray user token before hr-mcp sees them.
    assertions:
      request:
        replace_inherited: true
        strip:
          - x-user-token
          - x-auth-*
    authorization:
      pre_invocation:
        # First, so a suspended agent is refused before anything else runs.
        - "run(agent-status)"
        # `subject: user` names the inbound credential to exchange, keyed by the
        # TokenRole that jwt-agent registered (role: user). The engine's subject
        # vocabulary is user | client | caller_workload | this_workload — there
        # is no `agent`, and on this route the agent IS the inbound subject.
        #
        # The agent holds no standing GitHub entitlement: this obtains one for
        # the call, audience-scoped to github-api.
        - "delegate(github-oauth, target: github-api, audience: github-api, permissions: [repo:read:internal], subject: user)"
        - "!delegation.granted: deny"
        - "run(audit-log)"

  - tool: send_email
    authorization:
      pre_invocation:
        - "require(perm.email_send)"
        - "run(audit-log)"
        - "run(pii-scan)"
        - "security.labels contains \"secret\": deny('external email blocked: this session accessed secret data', 'session_tainted_secret')"

  # Sensitive mutating action. Small changes go straight through; an
  # adjustment over $10K requires the requester's manager to approve
  # out-of-band (CIBA), and the approval is bound to the live amount
  # (`scope`) so it can't be replayed against a larger change. This
  # route is PDP-independent (no cedar:/cel:/opa: step), so it behaves
  # identically under all three variants.
  - tool: adjust_compensation
    authorization:
      pre_invocation:
        - "require(role.hr)"
        - when: "args.amount > 10000"
          do:
            - "require_approval(manager-approver, from: claim.manager, channel: \"ciba\", scope: \"args.amount <= 25000\", purpose: \"Approve a compensation adjustment\", timeout: 24h)"
        - "run(audit-log)"
