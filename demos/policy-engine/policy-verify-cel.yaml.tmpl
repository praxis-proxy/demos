# IBM Verify + CEL policy.
# Edit this template; restart.sh renders policy-verify-cel.yaml.
# Run: USE_VERIFY=true GATEWAY_CONFIG=praxis-verify-cel.yaml ./restart.sh
# Tenant and client ids come from post_deploy_variables.json or VERIFY_* overrides.
# Secrets are read from the environment at runtime.
# Use claim_mapper: ibmverify to normalize scalar role and permission claims.

engine_settings:
  dispatch: policy

plugins:
  # User identity. Carries the human's roles + permissions claims.
  - name: jwt-user
    capabilities:
      # Required for outbound IdP requests.
      - perform_http
    kind: identity/jwt
    hooks: [identity.resolve]
    mode: sequential
    on_error: fail
    config:
      role: user
      header: X-User-Token
      # Keycloak remains trusted for the chat client and approval flow.
      # Verify uses the registered resource name praxis-gateway as its audience.
      trusted_issuers:
        - issuer: "${VERIFY_TENANT_URL}/oauth2"
          audiences: ["praxis-gateway"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "${VERIFY_TENANT_URL}/oauth2/jwks"
          leeway_seconds: 60
        - issuer: "http://localhost:8081/realms/policy-demo"
          audiences: ["praxis-gateway"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "http://localhost:8081/realms/policy-demo/protocol/openid-connect/certs"
            insecure_http: true   # localhost dev — never production
          leeway_seconds: 60
      claim_mapper: ibmverify

  # Client identity. Carries the agent's client_id / azp.
  - name: jwt-client
    capabilities:
      # Required for outbound IdP requests.
      - perform_http
    kind: identity/jwt
    hooks: [identity.resolve]
    mode: sequential
    on_error: fail
    config:
      role: client
      header: Authorization
      # Verify first, Keycloak as a workaround — same reasoning as jwt-user.
      trusted_issuers:
        - issuer: "${VERIFY_TENANT_URL}/oauth2"
          audiences: ["praxis-gateway", "account"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "${VERIFY_TENANT_URL}/oauth2/jwks"
          leeway_seconds: 60
        - issuer: "http://localhost:8081/realms/policy-demo"
          audiences: ["praxis-gateway"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "http://localhost:8081/realms/policy-demo/protocol/openid-connect/certs"
            insecure_http: true   # localhost dev — never production
          leeway_seconds: 60
      claim_mapper: ibmverify

  # Scenario 14 authenticates an agent with its client-credentials JWT.
  # It carries no user roles or teams.
  - name: jwt-agent
    capabilities:
      - perform_http
    kind: identity/jwt
    hooks: [identity.resolve]
    mode: sequential
    on_error: fail
    config:
      # role: user stores the agent as security.subject for this route.
      role: user
      header: X-Agent-Token
      trusted_issuers:
        - issuer: "${VERIFY_TENANT_URL}/oauth2"
          # The agent's client lists praxis-gateway in its audiences so the
          # gateway can validate the token it is handed.
          audiences: ["praxis-gateway"]
          algorithms: ["RS256"]
          decoding_key:
            kind: jwks_url
            url: "${VERIFY_TENANT_URL}/oauth2/jwks"
          leeway_seconds: 60
      # This token has no user role or permission claims to normalize.
      claim_mapper: standard

  # Scenario 14 checks agent status in the registry. Verify can still issue
  # tokens after suspension; the cache TTL bounds enforcement delay.
  - name: agent-status
    kind: validator/agent-status
    hooks: [cmf.tool_pre_invoke]
    mode: sequential
    on_error: fail
    capabilities:
      - perform_http      # the registry GET and the admin token mint
      - read_subject      # unlocks security.subject
      - read_claims       # ... and its claims, where an agent id may appear
    config:
      registry_url: "${VERIFY_TENANT_URL}/v1.0/Agents"
      # Registry id written by verify/import-verify-clients.sh.
      # The token does not carry this id.
      agent_id: "${VERIFY_AGENT_ID}"
      # Use the readAgents client provisioned in .env.verify.
      # Status changes use a separate manageAgentStatus credential.
      admin_client_id: "${VERIFY_AGENT_READER_CLIENT_ID}"
      # Read the secret from the environment populated by .env.verify.
      admin_client_secret_env: VERIFY_AGENT_READER_CLIENT_SECRET
      cache_ttl_seconds: 5
      # Deny if the registry cannot be reached.
      on_unavailable: deny

  # Exchange the user token for Workday access; retain the user permissions.
  - name: workday-oauth
    kind: delegator/oauth
    hooks: [token.delegate]
    mode: sequential
    on_error: fail
    capabilities:
      # Required for outbound IdP requests.
      - perform_http
      - read_inbound_credentials
      - write_delegated_tokens
    config:
      token_endpoint: "${VERIFY_TENANT_URL}/oauth2/token"
      # Use the exchange client; Verify rejects exchanging tokens issued by the
      # same client (CSIAQ5207E).
      client_id: "${VERIFY_GATEWAY_CLIENT_ID}"
      # restart.sh loads this secret from .env.verify.
      client_secret_source:
        kind: env_var
        name: VERIFY_GATEWAY_CLIENT_SECRET
      timeout_seconds: 5
      default_outbound_header: "Authorization"

  # Scan tool arguments for PII before invocation.
  - name: pii-scan
    kind: validator/pii-scan
    hooks: [cmf.tool_pre_invoke]
    mode: sequential
    on_error: fail
    config:
      detect:
        - { kind: ssn }
        - { kind: credit_card }
      mode: deny

  # Emit JSON audit records for tool calls.
  - name: audit-log
    kind: audit/logger
    hooks:
      - cmf.tool_pre_invoke
    mode: sequential
    # Run last to record the decision and delegated tokens.
    on_error: ignore  # observation failures don't halt traffic
    capabilities:
      - read_subject
      - read_client
      - read_meta
      - read_delegated_tokens
    config:
      destination: stderr
      source: policy-demo-gateway

  # Verify echoes the requested scope. The permissions assertion below checks
  # the exchanged token; it does not prove an IdP entitlement decision.
  - name: github-oauth
    kind: delegator/oauth
    hooks: [token.delegate]
    mode: sequential
    on_error: fail
    capabilities:
      # Required for outbound IdP requests.
      - perform_http
      - read_inbound_credentials
      - write_delegated_tokens
    config:
      token_endpoint: "${VERIFY_TENANT_URL}/oauth2/token"
      # Use the exchange client; Verify rejects exchanging tokens issued by the
      # same client (CSIAQ5207E).
      client_id: "${VERIFY_GATEWAY_CLIENT_ID}"
      client_secret_source:
        kind: env_var
        name: VERIFY_GATEWAY_CLIENT_SECRET
      timeout_seconds: 5
      default_outbound_header: "Authorization"

  # Request manager approval through Keycloak CIBA. Pending calls return -32120.
  - name: manager-approver
    capabilities:
      # Required for outbound IdP requests.
      - perform_http
    kind: elicitation/ciba
    hooks: [elicit]
    mode: sequential
    on_error: fail
    config:
      # CIBA still uses Keycloak. Keep both endpoints on the same IdP, and run
      # scenario 11 with a Keycloak configuration.
      backchannel_endpoint: "http://localhost:8081/realms/policy-demo/protocol/openid-connect/ext/ciba/auth"
      token_endpoint: "http://localhost:8081/realms/policy-demo/protocol/openid-connect/token"
      insecure_http: true   # localhost dev — never production
      client_id: "praxis-gateway"
      client_secret_source:
        kind: literal
        secret: "praxis-gateway-secret"
      scope: openid
      approver_claim: preferred_username
      default_requested_expiry_seconds: 120

global:
  authentication:
    - jwt-user
    - jwt-client

  # Assert engine-derived identity in upstream headers (scenario 12).
  # These headers are unsigned; the backend must trust its connection to the gateway.
  assertions:
    request:
      headers:
        # Require the resolved subject id.
        - name: x-auth-user-id
          from: subject.id
          on_missing: deny

        # The human-readable name, for the demo log. A claim, not a slot.
        - name: x-auth-username
          from: claim.preferred_username

        # Encode the sorted collection explicitly for stable header values.
        - name: x-auth-roles
          from: subject.roles
          encode: csv

        # `members:` renders one JSON object with operator-chosen keys, for
        # everything that would otherwise be a header each.
        - name: x-auth-context
          members:
            manager: claim.manager
            teams: subject.teams

      # Strip the original user token. Delegation replaces Authorization with
      # the exchanged token. Protocol headers such as Host cannot be stripped.
      strip:
        - x-user-token


  # Evaluate cel: predicates against the shared policy attributes.
  # Only true permits the request; false, missing attributes, and errors deny.
  pdp:
    - kind: cel
      on_error: deny   # fail-closed; the default, spelled out

  # Persist session taint in Valkey across gateway restarts (scenarios 08/09).
  # Labels are keyed by subject and session id.
  session_store:
    kind: valkey
    endpoint: localhost:6379

routes:

  # Compensation access and SSN redaction: scenarios 01-03.
  # Reading compensation taints the session: scenarios 08/09.
  - tool: get_compensation
    authorization:
      pre_invocation:
        - "require(role.hr)"
        - "delegate(workday-oauth, target: workday-api, audience: workday-api, permissions: [read_compensation])"
        - "taint(secret, session)"
        - "run(audit-log)"
    args:
      ssn: "str | redact(!perm.view_ssn)"
    result:
      ssn: "str | redact(!perm.view_ssn)"

  # Repository access: scenarios 04-06. Check the team, consult the PDP,
  # exchange the token, then check its permissions.
  - tool: search_repos
    authorization:
      pre_invocation:
        - "require(team.engineering | team.security)"
        - cel:
            expr: |
              (has(role.engineer) && role.engineer && args.visibility == "internal")
              || (has(role.security) && role.security)
            on_deny:
              - "deny('engineering may read internal repos only; security may read any', 'cel.policy_denied')"
        - "delegate(github-oauth, target: github-api, audience: github-api, permissions: [repo:read:internal])"
        - "!(delegation.granted.permissions contains 'repo:read:internal'): deny"
        - "run(audit-log)"
  # Scenario 14 authenticates with X-Agent-Token only. Check registry status
  # before delegation. This token has no team claim, and APL cannot assert its scope.
  - tool: search_repos_agent
    authentication:
      replace_inherited: true
      steps:
        - jwt-agent
    # Replace user assertions and strip caller-supplied identity headers.
    assertions:
      request:
        replace_inherited: true
        strip:
          - x-user-token
          - x-auth-*
    authorization:
      pre_invocation:
        # First, so a suspended agent is refused before anything else runs.
        - "run(agent-status)"
        # Exchange the agent credential registered by jwt-agent with role: user.
        - "delegate(github-oauth, target: github-api, audience: github-api, permissions: [repo:read:internal], subject: user)"
        - "!delegation.granted: deny"
        - "run(audit-log)"

  # Email permission, PII scanning, and session-taint checks: scenarios 07-09.
  # Audit before denial so blocked attempts are recorded.
  - tool: send_email
    authorization:
      pre_invocation:
        - "require(perm.email_send)"
        - "run(audit-log)"
        - "run(pii-scan)"
        - "security.labels contains \"secret\": deny('external email blocked: this session accessed secret data', 'session_tainted_secret')"

  # Compensation adjustments: scenario 10 applies amounts up to $10K.
  # Scenario 11 requires manager approval and runs on Keycloak.
  - tool: adjust_compensation
    authorization:
      pre_invocation:
        - "require(role.hr)"
        - when: "args.amount > 10000"
          do:
            - "require_approval(manager-approver, from: claim.manager, channel: \"ciba\", scope: \"args.amount <= 25000\", purpose: \"Approve a compensation adjustment\", timeout: 24h)"
        - "run(audit-log)"
