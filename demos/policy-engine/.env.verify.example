# IBM Verify credentials. Copy to .env.verify; restart.sh loads it.
# Set VERIFY_GATEWAY_CLIENT_SECRET from post_deploy_variables.json after import.
# The exchange client must differ from the minting client (CSIAQ5207E).
# Minting credentials are read from post_deploy_variables.json.
VERIFY_GATEWAY_CLIENT_SECRET=

# Scenario 14 uses separate credentials created by import-verify-clients.sh:
#   VERIFY_AGENT_READER_CLIENT_ID/_SECRET    readAgents (gateway)
#   VERIFY_AGENT_OPERATOR_CLIENT_ID/_SECRET  manageAgentStatus (status script)
# The importer saves these in .env.verify and writes the agent ids to
# post_deploy_variables.json. Keep tenant-admin credentials for provisioning.

# Provisioning credentials for import-verify-users.sh and import-verify-clients.sh.
# Create an API client under Security -> API access with these entitlements:
#   manageUsers          POST/DELETE /v2.0/Users
#   manageAttributes     POST /v1.0/attributes
#   manageAppAccessAdmin  /v1.0/applications (client importer only)
VERIFY_ADMIN_CLIENT_ID=
VERIFY_ADMIN_CLIENT_SECRET=
